# Upstash Redis — sert UNIQUEMENT à stocker les matchs/cotes que tu ajoutes
# via /matches/new. Gratuit sur upstash.com (crée une base Redis, onglet
# "REST API" pour récupérer ces 2 valeurs). Sans ces variables, l'app utilise
# un stockage en mémoire (pratique en local, mais perdu à chaque redémarrage
# du serveur — à éviter en production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Aucune clé requise pour les stats joueurs : elles sont récupérées EN DIRECT
# (aucun cache, aucun stockage) depuis le dataset ouvert Jeff Sackmann à
# chaque consultation. Voir lib/data-providers/sackmann-live.ts.

# Code requis pour ajouter ou supprimer un match (protège /matches/new et le
# bouton de suppression sur les cartes de match). Par défaut : 0000.
MATCHES_ACCESS_CODE=0000
